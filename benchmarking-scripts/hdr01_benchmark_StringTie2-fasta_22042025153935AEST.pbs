cd ${PBS_O_WORKDIR}
module load cufflinks/2.2.1
gffread stringtie2_11042025143926AEST/stringtie2-short.gtf -g /working/lab_julietF/isabelaA/data/references/GenomeGRCh38p7.fa -w stringtie2_11042025143926AEST/stringtie2-short.fasta
gffread stringtie2_11042025143926AEST/stringtie2-long.gtf -g /working/lab_julietF/isabelaA/data/references/GenomeGRCh38p7.fa -w stringtie2_11042025143926AEST/stringtie2-long.fasta
gffread stringtie2_11042025143926AEST/stringtie2-hybrid.gtf -g /working/lab_julietF/isabelaA/data/references/GenomeGRCh38p7.fa -w stringtie2_11042025143926AEST/stringtie2-hybrid.fasta
