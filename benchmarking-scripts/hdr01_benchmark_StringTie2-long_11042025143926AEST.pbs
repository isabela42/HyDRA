#!/bin/sh

##########################################################################
#
#  Script:  hdr01_benchmark_StringTie2-long_11042025143926AEST.pbs
#  Author:  Isabela Almeida
#  Created: Fri Apr 11 02:39:26 PM AEST 2025 at QIMR Berghofer (Brisbane, Australia) - VSC
#  Updated: Fri Apr 11 02:39:26 PM AEST 2025 at QIMR Berghofer (Brisbane, Australia) - VSC
#  Version: v01
#  Email:   Isabela.Almeida@qimrberghofer.edu.au
#
##########################################################################

#PBS -N hdr01_benchmark_StringTie2-long_11042025143926AEST
#PBS -r n
#PBS -l mem=100GB,walltime=150:00:00,ncpus=1
#PBS -m abe
#PBS -M Isabela.Almeida@qimrberghofer.edu.au

#................................................
#  Set main working directory
#................................................

## Change to main directory
cd ${PBS_O_WORKDIR}

echo ; echo "WARNING: The main directory for this run was set to ${PBS_O_WORKDIR}"; echo 

#................................................
#  Load Softwares, Libraries and Modules
#................................................

module load stringtie/2.2.1
module load samtools/1.9

#................................................
#  Run step
#................................................

echo "## Sort alignment files and save as bam at" ; date ; echo
samtools view -u stringtie2_11042025143926AEST/long-aligned.sam | samtools sort -@ 1 -o stringtie2_11042025143926AEST/long-aligned.sorted.bam

echo "## Run StringTie2 at" ; date ; echo
stringtie -o stringtie2_11042025143926AEST/stringtie2-long.gtf -L stringtie2_11042025143926AEST/long-aligned.sorted.bam

# based on
# https://journals.plos.org/ploscompbiol/article?id=10.1371/journal.pcbi.1009730
# https://doi.org/10.1371/journal.pcbi.1009730
# https://github.com/gpertea/stringtie
