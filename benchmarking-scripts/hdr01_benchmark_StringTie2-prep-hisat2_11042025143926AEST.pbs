#PBS -N hdr01_benchmark_StringTie2-prep-hisat2_11042025143926AEST
#PBS -r n
#PBS -l mem=20GB,walltime=50:00:00,ncpus=1
#PBS -m abe
#PBS -M Isabela.Almeida@qimrberghofer.edu.au

#................................................
#  Set main working directory
#................................................

## Change to main directory
cd ${PBS_O_WORKDIR}

echo ; echo "WARNING: The main directory for this run was set to ${PBS_O_WORKDIR}"; echo 

#................................................
#  Load Softwares, Libraries and Modules
#................................................

module load hisat2/2.2.1

#................................................
#  Run step
#................................................

#echo "## Run HISAT2 at" ; date ; echo
#hisat2-build /working/lab_julietF/isabelaA/data/references/GenomeGRCh38p7.fa /working/lab_julietF/isabelaA/data/references/GenomeGRCh38p7_hisat2_index

echo "## Run HISAT2 at" ; date ; echo
hisat2 -x /working/lab_julietF/isabelaA/data/references/GenomeGRCh38p7_hisat2_index -1 rnaSPAdes_11042025143926AEST/ribodepleted-short_R1.cor.fq.gz -2 rnaSPAdes_11042025143926AEST/ribodepleted-short_R2.cor.fq.gz -S stringtie2_11042025143926AEST/short-aligned.sam

