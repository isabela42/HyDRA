#PBS -N hdr01_benchmark_UNAGI_11042025143926AEST
#PBS -r n
#PBS -l mem=800GB,walltime=300:00:00,ncpus=1
#PBS -m abe
#PBS -M Isabela.Almeida@qimrberghofer.edu.au

#................................................
#  Set main working directory
#................................................

## Change to main directory
cd /working/lab_julietF/isabelaA/tools/UNAGI/

echo ; echo "WARNING: The main directory for this run was set to /working/lab_julietF/isabelaA/tools/UNAGI/"; echo 

#................................................
#  Load Softwares, Libraries and Modules
#................................................

module load python/3.6.1

#................................................
#  Run step
#................................................

cat /working/lab_julietF/isabelaA/Project_HyDRA/ipda_hdr01_all-sl/HYDRA_step06L1_ribodepletion_BBDuk_11092023141750AEST/ribo-depleted_corrected_polyA-trimmed_quality-trimmed_adapter-trimmed_PGAXXF230181_pass*.fasta > /working/lab_julietF/isabelaA/Project_HyDRA/benchmarking/assemblers/treated-data/ribodepleted-long.fastq

echo "## Run UNAGI at" ; date ; echo
/working/lab_julietF/isabelaA/tools/UNAGI/unagi -i /working/lab_julietF/isabelaA/Project_HyDRA/benchmarking/assemblers/treated-data/ribodepleted-long.fastq -o /working/lab_julietF/isabelaA/Project_HyDRA/benchmarking/assemblers/treated-data/unagi_11042025143926AEST -g /working/lab_julietF/isabelaA/data/references/GenomeGRCh38p7.fa

