#PBS -N hdr01_benchmark_rnaSPAdes_11042025143926AEST
#PBS -r n
#PBS -l mem=400GB,walltime=100:00:00,ncpus=40
#PBS -m abe
#PBS -M Isabela.Almeida@qimrberghofer.edu.au

#................................................
#  Set main working directory
#................................................

## Change to main directory
cd ${PBS_O_WORKDIR}

echo ; echo "WARNING: The main directory for this run was set to ${PBS_O_WORKDIR}"; echo 

#................................................
#  Load Softwares, Libraries and Modules
#................................................

module load SPAdes/3.14.1

#................................................
#  Run step
#................................................

echo "## Run rnaSPAdes at" ; date ; echo
rnaspades.py --checkpoint all -t 40 -m 400 -1 rnaSPAdes_11042025143926AEST/ribodepleted-short_R1.cor.fq.gz -2 rnaSPAdes_11042025143926AEST/ribodepleted-short_R2.cor.fq.gz --nanopore rnaSPAdes_11042025143926AEST/ribodepleted-long.fa.gz -o HYDRA_step11H1_de-novo-transcriptome-assembly_rnaSPAdes_11042025143926AEST
